					<Script isActive="yes" isFolder="no">
						<name>Sound Core</name>
						<packageName></packageName>
						<script>GUI.Sound = GUI.Sound or {}
local Sound = GUI.Sound

Sound.TAG = "LuminariGUI"
Sound.ORDER = {"chat", "low_health", "low_moves"}
Sound.ALIASES = {
  chat = "chat",
  health = "low_health",
  low_health = "low_health",
  moves = "low_moves",
  movement = "low_moves",
  low_moves = "low_moves",
}
Sound.DEFAULTS = {
  masterEnabled = true,
  channels = {
    chat = {
      label = "Chat",
      enabled = false,
      file = "audio/chat_sound.mp3",
      volume = 100,
      cooldown = 0,
      priority = 40,
    },
    low_health = {
      label = "Low health",
      enabled = false,
      file = "audio/health_warning.wav",
      volume = 75,
      cooldown = 30,
      priority = 80,
      threshold = 25,
      reset = 35,
    },
    low_moves = {
      label = "Low movement",
      enabled = false,
      file = "audio/movement_warning.wav",
      volume = 65,
      cooldown = 30,
      priority = 60,
      threshold = 20,
      reset = 30,
    },
  },
}
Sound.lastPlayed = Sound.lastPlayed or {}
Sound.latches = Sound.latches or {}
Sound.lastFailure = Sound.lastFailure or {}

local function copyTable(value)
  if type(value) ~= "table" then
    return value
  end
  local result = {}
  for key, child in pairs(value) do
    result[key] = copyTable(child)
  end
  return result
end

local function clamp(value, minimum, maximum, fallback)
  value = tonumber(value)
  if not value then
    return fallback
  end
  return math.max(minimum, math.min(maximum, value))
end

function Sound.channelName(name)
  if type(name) ~= "string" then
    return nil
  end
  return Sound.ALIASES[name:lower()]
end

function Sound.normalizedSettings(saved)
  local settings = copyTable(Sound.DEFAULTS)
  if type(saved) ~= "table" then
    return settings
  end
  if type(saved.masterEnabled) == "boolean" then
    settings.masterEnabled = saved.masterEnabled
  end
  local savedChannels = type(saved.channels) == "table" and saved.channels or {}
  for name, defaults in pairs(settings.channels) do
    local source = savedChannels[name]
    if type(source) == "table" then
      if type(source.enabled) == "boolean" then
        defaults.enabled = source.enabled
      end
      if type(source.file) == "string" and source.file ~= "" then
        local normalized = Sound.normalizeRelativeFile
          and Sound.normalizeRelativeFile(source.file)
        if normalized then
          defaults.file = normalized
        end
      end
      defaults.volume = clamp(source.volume, 0, 100, defaults.volume)
      defaults.cooldown = clamp(source.cooldown, 0, 3600, defaults.cooldown)
      defaults.priority = clamp(source.priority, 1, 100, defaults.priority)
      if defaults.threshold then
        defaults.threshold = clamp(source.threshold, 1, 95, defaults.threshold)
        defaults.reset = clamp(source.reset, defaults.threshold + 5, 100, defaults.reset)
      end
    end
  end
  return settings
end

function Sound.channel(name)
  local canonical = Sound.channelName(name)
  if not canonical then
    return nil, "unknown sound channel: " .. tostring(name)
  end
  Sound.settings = Sound.settings or Sound.normalizedSettings(nil)
  return Sound.settings.channels[canonical], canonical
end

function Sound.syncLegacyChat()
  local chat = Sound.settings and Sound.settings.channels.chat
  if not chat then
    return
  end
  GUI.toggles = GUI.toggles or {}
  GUI.toggles.chatSound = chat.enabled
  if demonnic and demonnic.chat and demonnic.chat.config then
    demonnic.chat.config.soundEnabled = chat.enabled
    demonnic.chat.config.soundFile = chat.file
    demonnic.chat.config.soundVolume = chat.volume
    demonnic.chat.config.soundCooldown = chat.cooldown
  end
end

function Sound.save()
  GUI.toggles = GUI.toggles or {}
  GUI.toggles.sound = Sound.settings
  Sound.syncLegacyChat()
  if type(GUI.saveToggles) ~= "function" then
    return false, "toggle persistence is unavailable"
  end
  local ok, errorMessage = pcall(GUI.saveToggles)
  if not ok then
    GUI.debugError("SOUND/SAVE", errorMessage)
    return false, tostring(errorMessage)
  end
  return true
end

function Sound.load()
  GUI.toggles = GUI.toggles or {}
  local saved = GUI.toggles.sound
  if type(saved) ~= "table" then
    local legacy = demonnic and demonnic.chat and demonnic.chat.config or {}
    saved = {
      channels = {
        chat = {
          enabled = GUI.toggles.chatSound == true or legacy.soundEnabled == true,
          file = legacy.soundFile,
          volume = legacy.soundVolume,
          cooldown = legacy.soundCooldown,
        },
      },
    }
  end
  Sound.settings = Sound.normalizedSettings(saved)
  Sound.latches = {}
  Sound.syncLegacyChat()
  Sound.save()
  GUI.debug("SOUND/LOAD", "sound settings loaded", Sound.settings)
  return Sound.settings
end

function Sound.normalizeRelativeFile(fileName)
  if type(fileName) ~= "string" then
    return nil, "sound file must be a relative path"
  end
  local normalized = fileName:gsub("\\", "/"):match("^%s*(.-)%s*$")
  if normalized == "" or normalized:sub(1, 1) == "/"
    or normalized:match("^%a:/") or normalized:find("://", 1, true)
  then
    return nil, "sound file must stay inside the profile or LuminariGUI package"
  end
  for segment in normalized:gmatch("[^/]+") do
    if segment == ".." then
      return nil, "sound file cannot traverse outside its sound directory"
    end
  end
  return normalized
end

function Sound.resolveFile(fileName)
  local normalized, pathError = Sound.normalizeRelativeFile(fileName)
  if not normalized then
    return nil, pathError
  end
  local home = getMudletHomeDir():gsub("\\", "/")
  local candidates = {
    home .. "/LuminariGUI/" .. normalized,
    home .. "/" .. normalized,
  }
  for _, path in ipairs(candidates) do
    local handle = io.open(path, "rb")
    if handle then
      handle:close()
      return path
    end
  end
  return nil, "sound file not found: " .. normalized
end

local function reportFailure(channel, message)
  if Sound.lastFailure[channel] ~= message then
    Sound.lastFailure[channel] = message
    GUI.debugError("SOUND/" .. channel, message)
  end
end

function Sound.play(name, options)
  options = options or {}
  local config, channel = Sound.channel(name)
  if not config then
    return false, channel
  end
  local force = options.force == true
  if not force and Sound.settings.masterEnabled == false then
    return false, "master-disabled"
  end
  if not force and config.enabled == false then
    return false, "channel-disabled"
  end
  local now = tonumber(options.now) or os.time()
  local lastPlayed = Sound.lastPlayed[channel]
  if not force and lastPlayed and now - lastPlayed &lt; config.cooldown then
    return false, "cooldown"
  end
  local path, pathError = Sound.resolveFile(config.file)
  if not path then
    reportFailure(channel, pathError)
    return false, pathError
  end
  local media = {
    name = path,
    volume = config.volume,
    key = "LuminariGUI." .. channel,
    tag = Sound.TAG,
    priority = config.priority,
  }
  local ok, result = pcall(playSoundFile, media)
  if not ok or result == false then
    local message = ok and "Mudlet rejected sound playback" or tostring(result)
    reportFailure(channel, message)
    return false, message
  end
  Sound.lastFailure[channel] = nil
  Sound.lastPlayed[channel] = now
  if channel == "chat" and demonnic and demonnic.chat then
    demonnic.chat.lastSoundTime = now
  end
  GUI.debug("SOUND/PLAY", "sound played", {channel = channel, media = media})
  return true, path
end

function Sound.checkThreshold(name, value, maximum)
  local config, channel = Sound.channel(name)
  value = tonumber(value)
  maximum = tonumber(maximum)
  if not config or not config.threshold or not value or not maximum or maximum &lt;= 0 then
    return false, "invalid-threshold-data"
  end
  local percentage = math.max(0, math.min(100, (value / maximum) * 100))
  if percentage &gt;= config.reset then
    Sound.latches[channel] = false
    return false, "armed"
  end
  if percentage &lt;= config.threshold then
    if Sound.latches[channel] then
      return false, "latched"
    end
    Sound.latches[channel] = true
    return Sound.play(channel)
  end
  return false, "unchanged"
end

function Sound.stopAll()
  if type(stopSounds) ~= "function" then
    return false, "Mudlet stopSounds API is unavailable"
  end
  local ok, result = pcall(stopSounds, {tag = Sound.TAG})
  if not ok or result == false then
    return false, ok and "Mudlet rejected stopSounds" or tostring(result)
  end
  return true
end</script>
						<eventHandlerList />
					</Script>
					<Script isActive="yes" isFolder="no">
						<name>Sound Commands</name>
						<packageName></packageName>
						<script>local Sound = GUI.Sound

local function soundEcho(message, color)
  cecho("\n&lt;" .. (color or "cyan") .. "&gt;[SOUND] " .. message .. "&lt;reset&gt;")
end

function Sound.setMaster(enabled)
  Sound.settings = Sound.settings or Sound.normalizedSettings(nil)
  Sound.settings.masterEnabled = enabled == true
  local saved, saveError = Sound.save()
  return saved, saved and Sound.settings.masterEnabled or saveError
end

function Sound.setEnabled(name, enabled)
  local config, channel = Sound.channel(name)
  if not config then
    return false, channel
  end
  config.enabled = enabled == true
  local saved, saveError = Sound.save()
  return saved, saved and config.enabled or saveError
end

function Sound.setFile(name, fileName)
  local config, channel = Sound.channel(name)
  if not config then
    return false, channel
  end
  local normalized, pathError = Sound.normalizeRelativeFile(fileName)
  if not normalized then
    return false, pathError
  end
  config.file = normalized
  local saved, saveError = Sound.save()
  return saved, saved and normalized or saveError
end

function Sound.setNumber(name, field, value)
  local config, channel = Sound.channel(name)
  if not config then
    return false, channel
  end
  local number = tonumber(value)
  local ranges = {
    volume = {0, 100},
    cooldown = {0, 3600},
    threshold = {1, 95},
  }
  local range = ranges[field]
  if not number or not range or number &lt; range[1] or number &gt; range[2] then
    return false, string.format(
      "%s must be between %d and %d",
      tostring(field),
      range and range[1] or 0,
      range and range[2] or 0
    )
  end
  if field == "threshold" and not config.threshold then
    return false, "threshold is only available for health and movement alerts"
  end
  config[field] = number
  if field == "threshold" then
    config.reset = math.min(100, math.max(config.reset, number + 5))
    Sound.latches[channel] = false
  end
  local saved, saveError = Sound.save()
  return saved, saved and number or saveError
end

function Sound.describe(name)
  local config, channel = Sound.channel(name)
  if not config then
    return channel
  end
  local threshold = config.threshold
    and string.format(", threshold=%g%%", config.threshold)
    or ""
  return string.format(
    "%s: %s, volume=%g, cooldown=%gs, file=%s%s",
    config.label,
    config.enabled and "ON" or "OFF",
    config.volume,
    config.cooldown,
    config.file,
    threshold
  )
end

function Sound.printStatus(name)
  if name then
    soundEcho(Sound.describe(name), "yellow")
    return
  end
  soundEcho(
    "Master sounds " .. (Sound.settings.masterEnabled and "ON" or "OFF"),
    "yellow"
  )
  for _, channel in ipairs(Sound.ORDER) do
    cecho("\n&lt;white&gt;  " .. Sound.describe(channel) .. "&lt;reset&gt;")
  end
end

function Sound.printHelp()
  soundEcho("Commands", "cyan")
  cecho("\n&lt;white&gt;  sound status&lt;reset&gt; - Show every channel")
  cecho("\n&lt;white&gt;  sound all on|off&lt;reset&gt; - Master switch")
  cecho("\n&lt;white&gt;  sound chat|health|moves on|off&lt;reset&gt;")
  cecho("\n&lt;white&gt;  sound &lt;channel&gt; volume &lt;0-100&gt;&lt;reset&gt;")
  cecho("\n&lt;white&gt;  sound &lt;channel&gt; cooldown &lt;0-3600&gt;&lt;reset&gt;")
  cecho("\n&lt;white&gt;  sound &lt;channel&gt; file &lt;relative path&gt;&lt;reset&gt;")
  cecho("\n&lt;white&gt;  sound health|moves threshold &lt;1-95&gt;&lt;reset&gt;")
  cecho("\n&lt;white&gt;  sound &lt;channel&gt; test | sound stop&lt;reset&gt;")
end

function Sound.handleCommand(arguments)
  Sound.settings = Sound.settings or Sound.normalizedSettings(nil)
  local input = type(arguments) == "string" and arguments:match("^%s*(.-)%s*$") or ""
  if input == "" or input == "status" then
    Sound.printStatus()
    return true, "status"
  end
  if input == "help" then
    Sound.printHelp()
    return true, "help"
  end
  if input == "stop" then
    local stopped, stopError = Sound.stopAll()
    soundEcho(stopped and "Stopped LuminariGUI sounds" or stopError, stopped and "green" or "red")
    return stopped, stopError
  end

  local channelToken, action, value = input:match("^(%S+)%s*(%S*)%s*(.-)%s*$")
  channelToken = channelToken and channelToken:lower() or ""
  action = action and action:lower() or ""
  if channelToken == "all" and (action == "on" or action == "off") then
    local changed, result = Sound.setMaster(action == "on")
    soundEcho(changed and "Master sounds " .. action:upper() or result, changed and "green" or "red")
    return changed, result
  end

  local config, channel = Sound.channel(channelToken)
  if not config then
    Sound.printHelp()
    return false, channel
  end
  if action == "" or action == "status" then
    Sound.printStatus(channel)
    return true, "status"
  end
  if action == "on" or action == "off" then
    local changed, result = Sound.setEnabled(channel, action == "on")
    soundEcho(changed and config.label .. " sounds " .. action:upper() or result, changed and "green" or "red")
    return changed, result
  end
  if action == "test" then
    local played, result = Sound.play(channel, {force = true})
    soundEcho(played and "Played " .. config.label .. " test" or result, played and "green" or "red")
    return played, result
  end

  local changed, result
  if action == "file" then
    changed, result = Sound.setFile(channel, value)
  elseif action == "volume" or action == "cooldown" or action == "threshold" then
    changed, result = Sound.setNumber(channel, action, value)
  else
    Sound.printHelp()
    return false, "unknown sound action: " .. tostring(action)
  end
  soundEcho(
    changed and string.format("%s %s set to %s", config.label, action, tostring(result)) or result,
    changed and "green" or "red"
  )
  return changed, result
end

function Sound.handleLegacyChatCommand(arguments)
  local suffix = type(arguments) == "string" and arguments or ""
  return Sound.handleCommand("chat " .. suffix)
end

function Sound.toggleChat()
  local chat = Sound.channel("chat")
  local enabled = not chat.enabled
  local changed, result = Sound.setEnabled("chat", enabled)
  if not changed then
    soundEcho(result, "red")
    return false, result
  end
  soundEcho("Chat sound notifications " .. (enabled and "ENABLED" or "DISABLED"), enabled and "green" or "red")
  if enabled then
    Sound.play("chat", {force = true})
  end
  return true, enabled
end</script>
						<eventHandlerList />
					</Script>
					<Script isActive="yes" isFolder="no">
						<name>GUI Boot</name>
						<packageName></packageName>
						<script>  -- CRITICAL: These initialization calls MUST remain outside any function!
  -- Mudlet requires GUI elements to be created immediately when the script loads.
  -- Moving these inside GUI.init() or any other function will cause complete failure.
  -- The GUI background, borders, and boxes must exist before any other initialization.
  -- This needs to be outside the config, since YATCO needs to have the boxes set.
	GUI.image_location = getMudletHomeDir():gsub("\\", "/") .. "/LuminariGUI/images/"
  GUI.debug("BOOT/CONFIG", "Config script reached", {
    imageLocation = GUI.image_location,
    initBackground = type(GUI.init_background),
    setBorders = type(GUI.set_borders),
    initBoxes = type(GUI.init_boxes),
  })

  -- These calls used to run unguarded before GUI.initializeOrRefresh was
  -- defined. Any one error aborted this entire script and produced the
  -- misleading "GUI system not fully loaded" message. In debug mode each
  -- stage now prints its entry, result, and stack trace, then allows the rest
  -- of the diagnostic/lifecycle functions to load.
  local bootStages = {
    {name = "GUI.init_background", callable = GUI.init_background},
    {name = "GUI.set_borders", callable = GUI.set_borders},
    {name = "GUI.init_boxes", callable = GUI.init_boxes},
  }
  for _, stage in ipairs(bootStages) do
    local ok, result = GUI.debugCall("BOOT/CONFIG/" .. stage.name, stage.callable)
    GUI.debugBootResults[stage.name] = {
      ok = ok,
      result = result,
    }
    GUI.debug("BOOT/CONFIG", "stage complete", {
      stage = stage.name,
      ok = ok,
      result = result,
    })
  end

function GUI.validateCoreLayout()
  local requiredParents = {
    Bottom = GUI.Bottom,
    chatContainer = GUI.chatContainer,
    chatContainerInner = GUI.chatContainerInner,
    buttonPanelContainer = GUI.buttonPanelContainer,
    roomInfoContainer = GUI.roomInfoContainer,
    statusGaugesContainer = GUI.Box7,
  }
  local missing = {}
  for name, value in pairs(requiredParents) do
    if type(value) ~= "table" then
      missing[#missing + 1] = name
    end
  end
  table.sort(missing)
  if #missing > 0 then
    return false, "missing core GUI parents: " .. table.concat(missing, ", ")
  end
  return true
end

function GUI.init()
  -- A pre-split lifecycle closure can survive an in-session package upgrade
  -- because that release did not retain its anonymous-handler ID. Both the
  -- legacy and current sysLoadEvent callbacks then reach this global function
  -- in the same event turn. Run the initialization sequence only once.
  if GUI.initCallPending then
    GUI.debug("GUI/INIT", "duplicate initialization call coalesced")
    return true
  end
  GUI.initCallPending = true
  GUI.setOwnedTimer("gui.initCallPending", 0.5, function()
    GUI.initCallPending = false
  end)

  GUI.debug("GUI/INIT", "initialization sequence starting", {
    alreadyInitialized = GUI.initialized,
  })
  GUI.AffectIcons = GUI.AffectIcons or {}
  GUI.Affects = GUI.Affects or {}
  GUI.Affects.Rows = GUI.Affects.Rows or {}
  GUI.Affects.Modes = GUI.Affects.Modes or {}

  GUI.initFailures = {}
  local coreReady, coreError = GUI.validateCoreLayout()
  if not coreReady then
    GUI.initFailures[1] = {
      stage = "GUI.validateCoreLayout",
      error = coreError,
    }
    GUI.initialized = false
    GUI.debugError("GUI/INIT/CORE", coreError)
    print("[GUI] Initialization stopped safely: " .. coreError)
    return false, coreError
  end

  local initStages = {
    {name = "GUI.init_gauges", callable = GUI.init_gauges},
    {name = "GUI.init_action_icons", callable = GUI.init_action_icons},
    {name = "GUI.tabbedInfoWindow.init", callable = GUI.tabbedInfoWindow.init},
    {name = "GUI.init_player", callable = GUI.init_player},
    {name = "GUI.init_group", callable = GUI.init_group},
    {name = "GUI.Affects.init", callable = GUI.Affects.init},
    {name = "GUI.draw_frames", callable = GUI.draw_frames},
    {name = "GUI.buttonWindow.init", callable = GUI.buttonWindow.init},
    {name = "GUI.init_castConsole", callable = GUI.init_castConsole},
    {name = "GUI.styleScrollbar", callable = GUI.styleScrollbar},
    {name = "GUI.registerEventHandlers", callable = GUI.registerEventHandlers},
  }

  for _, stage in ipairs(initStages) do
    local ok, result = GUI.debugCall("GUI/INIT/" .. stage.name, stage.callable)
    if not ok then
      GUI.initFailures[#GUI.initFailures + 1] = {
        stage = stage.name,
        error = result,
      }
    end
  end

  -- Ensure proper z-order of adjustable containers
  GUI.setOwnedTimer("gui.initZOrder", 0.5, GUI.debugWrap("GUI/INIT/z-order timer", function()
    -- Bring containers to front in correct order
    -- Map should be at the back
    if map and map.container then
      map.container:show()
    end
    if GUI.chatContainer then
      GUI.chatContainer:show()
    end
    if GUI.roomInfoContainer then
      GUI.roomInfoContainer:show()
      GUI.roomInfoContainer:raise()  -- Bring above map
    end
    if GUI.buttonPanelContainer then
      GUI.buttonPanelContainer:show()
      GUI.buttonPanelContainer:raise()  -- Bring to front
    end
    if GUI.actionIconsContainer then
      GUI.actionIconsContainer:show()
      GUI.actionIconsContainer:raise()  -- Bring to front
    end
  end))

  -- Preserve the old failure semantics: before diagnostic catching, an error
  -- prevented this flag from ever being reached. A failed debug run therefore
  -- remains retryable through "fix gui".
  GUI.initialized = (#GUI.initFailures == 0)
  GUI.debug("GUI/INIT", "initialization sequence complete", {
    initialized = GUI.initialized,
    failures = GUI.initFailures,
  })
end

</script>
						<eventHandlerList />
					</Script>
					<Script isActive="yes" isFolder="no">
						<name>GUI Event Registry</name>
						<packageName></packageName>
						<script>-- Robust event handler registration with error handling and verification
GUI.EVENT_HANDLERS = {
    -- GUI event handlers
    ["msdp.GROUP"] = "GUI.updateGroup",
    ["msdp.AFFECTS"] = "GUI.updateAffectIcons",
    ["msdp.HEALTH"] = "GUI.updateHealthGauge",
    ["msdp.HEALTH_MAX"] = "GUI.updateHealthGauge",
    ["msdp.OPPONENT_HEALTH"] = "GUI.updateEnemyGauge",
    ["msdp.OPPONENT_HEALTH_MAX"] = "GUI.updateEnemyGauge",
    ["msdp.OPPONENT_NAME"] = "GUI.updateEnemyGauge",
    ["msdp.MOVEMENT"] = "GUI.updateMovesGauge",
    ["msdp.MOVEMENT_MAX"] = "GUI.updateMovesGauge",
    -- ["msdp.EXPERIENCE"] = "GUI.updateExperienceGauge",
    -- ["msdp.EXPERIENCE_TNL"] = "GUI.updateExperienceGauge",
    ["msdp.PSP"] = "GUI.updatePSPGauge",
    ["msdp.PSP_MAX"] = "GUI.updatePSPGauge",
    ["msdp.ACTIONS"] = "GUI.updateActionIcons",
    ["msdp.CHARACTER_NAME"] = "GUI.updatePlayer",
    ["msdp.RACE"] = "GUI.updatePlayer",
    ["msdp.CLASS"] = "GUI.updatePlayer",
    ["msdp.ALIGNMENT"] = "GUI.updatePlayer",
    ["msdp.LEVEL"] = "GUI.updatePlayer",
    ["msdp.STR"] = "GUI.updatePlayer",
    ["msdp.DEX"] = "GUI.updatePlayer",
    ["msdp.CON"] = "GUI.updatePlayer",
    ["msdp.INT"] = "GUI.updatePlayer",
    ["msdp.WIS"] = "GUI.updatePlayer",
    ["msdp.CHA"] = "GUI.updatePlayer",
    ["msdp.AC"] = "GUI.updatePlayer",
    ["msdp.MONEY"] = "GUI.updatePlayer",
    -- Room update for GUI display.
    -- NOTE: map.eventHandler ALSO handles msdp.ROOM, but it is registered at
    -- file scope in 00_msdpmapper.xml. Do not add it here as well -- Mudlet
    -- allows multiple handlers per event, so listing it twice made the mapper
    -- process every room change twice.
    ["msdp.ROOM"] = "GUI.updateRoom"
}

function GUI.unregisterEventHandlers()
  GUI.eventHandlerIds = GUI.eventHandlerIds or {}
  return GUI.unregisterOwnedHandlers(
    GUI.eventHandlerIds,
    GUI.EVENT_HANDLERS
  )
end

function GUI.registerEventHandlers()
  local eventHandlers = GUI.EVENT_HANDLERS

  -- Events deliberately NOT listed above, because 00_msdpmapper.xml already
  -- registers them at file scope (which runs at script-compile time, earlier
  -- and more reliably than GUI.init()):
  --   msdp.ROOM / shiftRoom / sysConnectionEvent / sysDownloadDone
  --       -> map.eventHandler
  --   sysProtocolEnabled  -> map.onProtocolEnabled
  -- GUI.onProtocolEnabled is separately owned by the lifecycle registry.

  -- Store handler IDs so repeat calls can clean up after themselves.
  GUI.eventHandlerIds = GUI.eventHandlerIds or {}

  -- This function runs on every GUI.init() AND every GUI.initializeOrRefresh().
  -- Without this cleanup each call stacked another copy of every handler, so
  -- after a few reconnects a single MSDP update fanned out to N duplicate
  -- handlers (duplicate REPORT storms, redundant redraws, growing latency).
  --
  -- Only clean up events owned by eventHandlers. Older releases also stored
  -- the five mapper handlers and a legacy GUI protocol handler in this table.
  -- Mudlet 4.21 can reuse those handler IDs when the same string handler
  -- is registered during an in-place upgrade; sweeping every legacy entry here
  -- would therefore kill the newly compiled file-scope handlers.
  local killed = GUI.unregisterEventHandlers()
  GUI.debug("EVENT/REGISTER", "owned handler cleanup complete", {
    killed = killed,
  })

  -- Register GUI event handlers
  for event, handler in pairs(eventHandlers) do
    local eventName = event
    local handlerName = handler
    local callback = handler
    if GUI.DEBUG == true then
      callback = function(...)
        local variableName = eventName:match("^msdp%.(.+)$")
        GUI.debug("EVENT/FIRE", eventName .. " -&gt; " .. handlerName, {
          arguments = {...},
          msdpVariable = variableName,
          msdpValue = variableName and msdp and msdp[variableName] or nil,
        })
        local callable = GUI.debugResolve(handlerName)
        local ok, result = GUI.debugCall(
          "EVENT/HANDLER/" .. eventName .. "/" .. handlerName,
          callable,
          ...
        )
        if not ok then
          return nil, result
        end
        return result
      end
    end

    local handlerId, handlerError = GUI.registerOwnedHandler(
      GUI.eventHandlerIds,
      eventName,
      eventName,
      callback,
      "GUI/" .. eventName
    )
    if handlerId then
      GUI.debug("EVENT/REGISTER", "registered GUI handler", {
        event = eventName,
        handler = handlerName,
        handlerId = handlerId,
        callbackType = type(callback),
      })
    else
      GUI.debugError(
        "EVENT/REGISTER/" .. eventName,
        "failed to register " .. handlerName .. ": " .. tostring(handlerError)
      )
      print(string.format("✗ Failed to register GUI handler for %s: %s", eventName, handlerError))
    end
  end

  -- Verify critical handlers are working and refresh displays
  GUI.setOwnedTimer("gui.eventVerification", 2, GUI.debugWrap("EVENT/VERIFY/two-second refresh", function()
    GUI.debug("EVENT/VERIFY", "checking current MSDP-backed displays", {
      msdpCount = GUI.debugCountEntries(msdp),
    })
    -- Group tab refresh
    if msdp.GROUP and #msdp.GROUP > 0 then
      GUI.updateGroup()
    end
    
    -- Gauge refreshes
    if msdp.HEALTH and msdp.HEALTH_MAX then
      GUI.updateHealthGauge()
    end
    if msdp.MOVEMENT and msdp.MOVEMENT_MAX then
      GUI.updateMovesGauge()
    end
    -- if msdp.EXPERIENCE and msdp.EXPERIENCE_TNL then
    --   GUI.updateExperienceGauge()
    -- end
    if msdp.PSP and msdp.PSP_MAX then
      GUI.updatePSPGauge()
    end
    
    -- Enemy gauge refresh (only if opponent data exists)
    if msdp.OPPONENT_NAME and msdp.OPPONENT_NAME ~= "" then
      GUI.updateEnemyGauge()
    else
      -- Hide enemy gauge if not in combat
      if GUI.Enemy then
        GUI.Enemy:hide()
      end
    end
    
    -- Player tab refresh
    if msdp.CHARACTER_NAME then
      GUI.updatePlayer()
    end
    
    -- Room info refresh
    if msdp.ROOM then
      GUI.updateRoom()
    end
  end))
  
  -- Initialize chat system if it's enabled but not created
  GUI.setOwnedTimer("gui.chatStartup", 1, GUI.debugWrap("EVENT/VERIFY/chat startup", function()
    GUI.debug("EVENT/VERIFY", "chat startup check", {
      demonnic = type(demonnic),
      chat = type(demonnic and demonnic.chat),
      use = demonnic and demonnic.chat and demonnic.chat.use,
      container = type(demonnic and demonnic.chat and demonnic.chat.container),
    })
    if demonnic.chat.use and not demonnic.chat.container then
      demonnicOnStart()
    end
  end))
end

</script>
						<eventHandlerList />
					</Script>
					<Script isActive="yes" isFolder="no">
						<name>GUI Refresh</name>
						<packageName></packageName>
						<script>-- =============================================================================
-- CENTRALIZED GUI INITIALIZATION SYSTEM
-- =============================================================================
-- This function provides a single point of control for all GUI initialization
-- and refresh operations. It should be called from ALL relevant entry points.
--
-- WHEN TO CALL THIS FUNCTION:
-- 1. Package load/install (sysLoadEvent, sysInstall) 
-- 2. Connection established (sysConnectionEvent)
-- 3. MSDP protocol enabled (sysProtocolEnabled)
-- 4. Manual refresh commands (fix gui, fix chat)
-- 5. After login/reconnect (when MSDP data starts flowing)
--
-- WHAT IT DOES:
-- - Initializes or refreshes all GUI components
-- - Re-registers event handlers that may have failed
-- - Refreshes all displays with current MSDP data
-- - Ensures proper container visibility and z-order
-- - Handles both initial setup and runtime refresh
-- =============================================================================
function GUI.initializeOrRefresh(context)
  context = context or "unknown"
  -- Coalesce matching callbacks from the legacy anonymous lifecycle handler
  -- and its replacement during a live package upgrade. Calls with different
  -- contexts still run independently (for example protocol enablement after
  -- a connection refresh).
  GUI.refreshCallsPending = GUI.refreshCallsPending or {}
  if GUI.refreshCallsPending[context] then
    GUI.debug("GUI/REFRESH", "duplicate refresh call coalesced", {
      context = context,
    })
    return true
  end
  GUI.refreshCallsPending[context] = true
  GUI.setOwnedTimer("gui.refreshCallPending." .. context, 0.5, function()
    GUI.refreshCallsPending[context] = nil
  end)

  -- resetProfile() clears Mudlet's protocol tables before sysLoadEvent fires.
  -- Recreate the MSDP table so an in-place GUI refresh remains safe while the
  -- renewed REPORT subscriptions are waiting for their first values.
  msdp = msdp or {}
  GUI.debug("GUI/REFRESH", "initializeOrRefresh requested", {
    context = context,
    initialized = GUI.initialized,
    initFailures = GUI.initFailures,
    msdpCount = GUI.debugCountEntries(msdp),
  })
  
  -- Track if this is initial setup or refresh
  local isRefresh = (GUI.initialized == true)
  
  if not isRefresh then
    -- GUI not initialized yet - initialize it now
    cecho(string.format("\n&lt;yellow&gt;Initializing GUI components (%s)...", context))
    GUI.init()
    return
  else
    -- Refresh existing GUI
    cecho(string.format("\n&lt;yellow&gt;Refreshing GUI components (%s)...", context))
  end
  
  -- Always ensure event handlers are registered
  GUI.registerEventHandlers()
  
  -- Refresh all adjustable containers
  local refreshed = {}
  
  -- Status Gauges
  if GUI.Box7 then
    GUI.Box7:show()
    GUI.Box7:raise()
    if msdp.HEALTH then GUI.updateHealthGauge() end
    if msdp.MOVEMENT then GUI.updateMovesGauge() end
    -- if msdp.EXPERIENCE then GUI.updateExperienceGauge() end
    if msdp.PSP then GUI.updatePSPGauge() end
    table.insert(refreshed, "status gauges")
  end
  
  -- TabbedInfo Window
  if GUI.tabbedInfoWindowContainer then
    GUI.tabbedInfoWindowContainer:show()
    GUI.tabbedInfoWindowContainer:raise()
    -- Ensure Player tab is visible and updated
    if GUI.tabbedInfoWindow and GUI.tabbedInfoWindow.Player then
      GUI.tabbedInfoWindow.click("Player")
      if msdp.CHARACTER_NAME then GUI.updatePlayer() end
    end
    table.insert(refreshed, "tabbed info window")
  end
  
  -- Action Icons
  if GUI.actionIconsContainer then
    GUI.actionIconsContainer:show()
    GUI.actionIconsContainer:raise()
    if msdp.ACTIONS then GUI.updateActionIcons() end
    table.insert(refreshed, "action icons")
  end
  
  -- Enemy gauge (combat only)
  if msdp.OPPONENT_NAME and msdp.OPPONENT_NAME ~= "" then
    GUI.updateEnemyGauge()
  elseif GUI.Enemy then
    GUI.Enemy:hide()
  end
  
  -- Group tab
  if GUI.groupWindow and msdp.GROUP then
    GUI.updateGroup()
    table.insert(refreshed, "Group tab")
  end
  
  -- Player tab
  if GUI.playerWindow and msdp.CHARACTER_NAME then
    GUI.updatePlayer()
    table.insert(refreshed, "Player tab")
  end
  
  -- Room info
  if GUI.Box5 and msdp.ROOM then
    GUI.updateRoom()
    table.insert(refreshed, "room info")
  end
  
  -- ASCII map
  if map.minimap and msdp.ROOM then
    map.eventHandler("msdp.ROOM")
    table.insert(refreshed, "ASCII map")
  end
  
  -- Mudlet mapper
  if map.mapwindow then
    map.mapwindow:show()
    map.mapwindow:resize()
    -- Force refresh with delayed operations
    GUI.setOwnedTimer("gui.refreshMapperResize", 0.1, GUI.debugWrap("GUI/REFRESH/mapper delayed resize", function()
      if map.mapwindow then
        map.mapwindow:resize()
        if map.mapwindow.raise then
          map.mapwindow:raise()
        end
        -- Try to center on current room
        if map.currentRoom and map.currentRoom > 0 then
          centerview(map.currentRoom)
        end
      end
    end))
    table.insert(refreshed, "Mudlet mapper")
  end
  
  -- Chat system
  if GUI.chatContainer then
    GUI.chatContainer:show()
    -- Initialize chat if needed
    if demonnic.chat.use and not demonnic.chat.container then
      demonnicOnStart()
      table.insert(refreshed, "chat system (initialized)")
    else
      table.insert(refreshed, "chat container")
    end
  end
  
  -- Button Panel (Controls)
  if GUI.buttonPanelContainer then
    GUI.buttonPanelContainer:show()
    GUI.buttonPanelContainer:raise()
    table.insert(refreshed, "button panel")
  end
  
  -- Room Info Container
  if GUI.roomInfoContainer then
    GUI.roomInfoContainer:show()
    GUI.roomInfoContainer:raise()
    -- Update room data if available
    if msdp.ROOM then
      GUI.updateRoom()
    end
    table.insert(refreshed, "room info container")
  end
  
  -- Cast Console
  if GUI.castConsoleContainer then
    GUI.castConsoleContainer:show()
    GUI.castConsoleContainer:raise()
    table.insert(refreshed, "cast console")
  end
  
  -- ASCII Map Container (ensure it exists before mode check)
  if GUI.asciiMapContainer then
    GUI.asciiMapContainer:show()
    table.insert(refreshed, "ASCII map container")
  end
  
  -- Handle map container visibility based on mode
  if GUI.buttonWindow and GUI.buttonWindow.mudletOrAscii then
    if GUI.buttonWindow.mudletOrAscii == "ASCII" then
      if map.container then map.container:hide() end
      if GUI.asciiMapContainer then
        GUI.asciiMapContainer:raise()
      end
    else
      if GUI.asciiMapContainer then GUI.asciiMapContainer:hide() end
      if map.container then
        map.container:show()
        map.container:raise()
      end
    end
  end
  
  -- Ensure proper z-order (delayed to allow all components to initialize)
  GUI.setOwnedTimer("gui.refreshZOrder", 0.5, GUI.debugWrap("GUI/REFRESH/z-order timer", function()
    -- Let Adjustable Containers manage their own z-order
    -- Only raise containers that need to be on top of others
    if GUI.chatContainer then GUI.chatContainer:raise() end
    if GUI.actionIconsContainer then GUI.actionIconsContainer:raise() end
  end))
  
  -- Report results
  if #refreshed > 0 then
    cecho(string.format("\n&lt;green&gt;%s complete: %s", 
      isRefresh and "Refresh" or "Initialization",
      table.concat(refreshed, ", ")))
  end
  GUI.debug("GUI/REFRESH", "initializeOrRefresh complete", {
    context = context,
    isRefresh = isRefresh,
    refreshed = refreshed,
  })
end

</script>
						<eventHandlerList />
					</Script>
					<Script isActive="yes" isFolder="no">
						<name>GUI Lifecycle</name>
						<packageName></packageName>
						<script>-- =============================================================================
-- ENTRY POINT HANDLERS
-- These ensure GUI.initializeOrRefresh is called at the right times
-- while preserving other initialization functions
-- =============================================================================

-- The onProtocolEnabled handler is defined in the MSDP script section
-- It handles MSDP variable registration and GUI initialization

-- The main initialization handlers are registered at the bottom of this script
-- along with the original GUI.init() registration to ensure proper order

local function runLifecycleStep(scope, callable)
  if type(callable) ~= "function" then
    GUI.debugError("LIFECYCLE/" .. scope, "required function is unavailable")
    return false
  end
  local ok, result = pcall(callable)
  if not ok then
    GUI.debugError("LIFECYCLE/" .. scope, result)
  end
  return ok, result
end

local function prepareLoadedState()
  runLifecycleStep("load preferences", GUI.loadToggles)
  runLifecycleStep("load sound settings", GUI.Sound and GUI.Sound.load)
  runLifecycleStep(
    "initialize layout profiles",
    GUI.AdjustableContainers and GUI.AdjustableContainers.init
  )
  runLifecycleStep("apply preferences", GUI.applyPreferencesAfterLoad)
end

-- Since Mudlet 4.20, sysLoadEvent passes a boolean: true for a fresh profile
-- load, false when it fires after resetProfile(). That distinction matters:
-- after a resetProfile() the connection is usually still up and MSDP was
-- already negotiated, so sysProtocolEnabled will NOT fire again and the GUI
-- would otherwise sit empty, never having sent its REPORT subscriptions.
function GUI.onSysLoadEvent(_, isNewLoad)
  GUI.debug("LIFECYCLE", "sysLoadEvent fired", {
    isNewLoad = isNewLoad,
    initializedBefore = GUI.initialized,
  })
  prepareLoadedState()
  GUI.init()
  if type(GUI.debugSnapshot) == "function" then
    GUI.debugCall(
      "SNAPSHOT/sysLoad immediate",
      GUI.debugSnapshot,
      "sysLoadEvent immediate"
    )
    GUI.setOwnedTimer("lifecycle.loadSnapshot", 2, GUI.debugWrap("LIFECYCLE/sysLoad delayed snapshot", function()
      GUI.debugCall(
        "SNAPSHOT/sysLoad delayed",
        GUI.debugSnapshot,
        "sysLoadEvent plus two seconds"
      )
    end))
  end

  -- isNewLoad == false means we came from resetProfile(). Older Mudlet
  -- versions pass nil here, so only take this path on an explicit false.
  if isNewLoad == false then
    GUI.setOwnedTimer("lifecycle.profileReset", 0.5, GUI.debugWrap("LIFECYCLE/profile reset recovery", function()
      if map and map.initialize then
        local ok, initialized = GUI.debugCall(
          "LIFECYCLE/profile reset/map.initialize",
          map.initialize
        )
        if not ok or initialized == false then
          print("[GUI] Mapper initialization failed after profile reset: " .. tostring(initialized))
        end
      else
        print("[GUI] Mapper initialization is unavailable after profile reset")
      end
      if GUI.requestMSDPReports() then
        print("[GUI] Re-subscribed to MSDP after profile reset")
      end
      GUI.initializeOrRefresh("profile reset")
    end))
  end
end

function GUI.onSysInstallEvent(_, packageName)
  if packageName ~= "LuminariGUI" then
    return
  end
  GUI.debug("LIFECYCLE", "LuminariGUI sysInstall fired")
  prepareLoadedState()
  GUI.init()
end

function GUI.onConnectionEvent(...)
  GUI.debug("LIFECYCLE", "sysConnectionEvent fired", {...})
  GUI.setOwnedTimer("lifecycle.connectionRefresh", 1, GUI.debugWrap("LIFECYCLE/connection refresh timer", function()
    GUI.initializeOrRefresh("connection established")
    if type(GUI.debugSnapshot) == "function" then
      GUI.debugCall(
        "SNAPSHOT/connection",
        GUI.debugSnapshot,
        "one second after connection"
      )
    end
  end))
end

function GUI.onExitEvent()
  runLifecycleStep("profile exit cleanup", GUI.cleanup)
end

function GUI.onUninstallPackage(_, packageName)
  if packageName ~= "LuminariGUI" then
    return
  end
  local ok, cleaned = runLifecycleStep(
    "package uninstall cleanup",
    GUI.cleanupPackageResources
  )
  if ok then
    GUI.debug("LIFECYCLE", "package resources removed", cleaned)
  end
end

-- Keep lifecycle registration idempotent when scripts are recompiled or a
-- fixed release is upgraded again in the same Mudlet session. The legacy
-- anonymous closures from pre-split releases did not expose IDs; the guarded
-- GUI entry points above coalesce their one unavoidable migration overlap.
GUI.lifecycleHandlerIds = GUI.lifecycleHandlerIds or {}
GUI.LIFECYCLE_HANDLERS = {
  ["sysLoadEvent"] = "GUI.onSysLoadEvent",
  ["sysInstall"] = "GUI.onSysInstallEvent",
  ["sysProtocolEnabled"] = "GUI.onProtocolEnabled",
  ["sysConnectionEvent"] = "GUI.onConnectionEvent",
  ["sysExitEvent"] = "GUI.onExitEvent",
  ["sysUninstallPackage"] = "GUI.onUninstallPackage",
}

function GUI.unregisterLifecycleHandlers()
  return GUI.unregisterOwnedHandlers(
    GUI.lifecycleHandlerIds,
    GUI.LIFECYCLE_HANDLERS
  )
end

local function registerLifecycleHandler(event, handler)
  local handlerId, handlerError = GUI.registerOwnedHandler(
    GUI.lifecycleHandlerIds,
    event,
    event,
    handler,
    "LIFECYCLE/" .. event
  )
  if not handlerId then
    GUI.debugError(
      "LIFECYCLE/register/" .. event,
      "failed to register " .. tostring(handler) .. ": " .. tostring(handlerError)
    )
  end
  return handlerId
end

registerLifecycleHandler("sysLoadEvent", "GUI.onSysLoadEvent")
registerLifecycleHandler("sysInstall", "GUI.onSysInstallEvent")

-- Register protocol handler early to ensure it catches MSDP enablement
-- This is critical because MSDP can be enabled before GUI.init() completes
registerLifecycleHandler("sysProtocolEnabled", "GUI.onProtocolEnabled")

-- Add connection-based refresh
registerLifecycleHandler("sysConnectionEvent", "GUI.onConnectionEvent")
registerLifecycleHandler("sysExitEvent", "GUI.onExitEvent")
registerLifecycleHandler("sysUninstallPackage", "GUI.onUninstallPackage")</script>
						<eventHandlerList />
					</Script>
					<Script isActive="yes" isFolder="no">
						<name>AdjustableContainers</name>
						<packageName></packageName>
						<script>-- Layout profiles and lifecycle support.
-- The core AdjustableContainers namespace is loaded by the earlier
-- 00_adjustablecontainers.xml fragment before GUI Config creates any boxes.
if not (
  GUI
  and GUI.AdjustableContainers
  and type(GUI.AdjustableContainers.create) == "function"
) then
  error("LuminariGUI AdjustableContainers foundation did not load")
end

-- Layout Profile System
GUI.AdjustableContainers.profiles = {
  default = {
    name = "Default Layout",
    description = "Standard layout for general gameplay",
    containers = {
      chat = { x = "25%", y = "-25%", width = "50%", height = "25%" },
      gauges = { x = "0%", y = "75%", width = "25%", height = "25%" },
      tabinfo = { x = "0%", y = "0%", width = "25%", height = "75%" },
      room = { x = "-25%", y = "15%", width = "25%", height = "35%" },
      buttons = { x = "-25%", y = "0%", width = "25%", height = "15%" },
      actions = { x = "-25%", y = "50%", width = "25%", height = "35%" },
      cast = { x = "30%", y = "10%", width = "40%", height = "20%" }
    }
  },
  combat = {
    name = "Combat Layout",
    description = "Optimized for combat situations",
    containers = {
      chat = { x = "25%", y = "-25%", width = "50%", height = "25%" },
      gauges = { x = "0%", y = "75%", width = "25%", height = "25%" },
      tabinfo = { x = "0%", y = "0%", width = "25%", height = "75%" },
      room = { x = "-25%", y = "15%", width = "25%", height = "35%" },
      buttons = { x = "-25%", y = "0%", width = "25%", height = "15%" },
      actions = { x = "-25%", y = "50%", width = "25%", height = "35%" },
      cast = { x = "30%", y = "10%", width = "40%", height = "20%" }
    }
  },
  social = {
    name = "Social Layout", 
    description = "Emphasizes chat and communication",
    containers = {
      chat = { x = "25%", y = "-40%", width = "50%", height = "40%" },
      gauges = { x = "0%", y = "85%", width = "25%", height = "15%" },
      tabinfo = { x = "0%", y = "0%", width = "25%", height = "85%" },
      room = { x = "-25%", y = "15%", width = "25%", height = "35%" },
      buttons = { x = "-25%", y = "0%", width = "25%", height = "15%" },
      actions = { x = "-25%", y = "50%", width = "25%", height = "35%" },
      cast = { x = "30%", y = "10%", width = "40%", height = "20%" }
    }
  },
  minimal = {
    name = "Minimal Layout",
    description = "Minimalist layout for maximum game text visibility",
    containers = {
      chat = { x = "20%", y = "-20%", width = "60%", height = "20%" },
      gauges = { x = "0%", y = "80%", width = "20%", height = "20%" },
      tabinfo = { x = "0%", y = "0%", width = "20%", height = "80%" },
      room = { x = "-20%", y = "10%", width = "20%", height = "30%" },
      buttons = { x = "-20%", y = "0%", width = "20%", height = "10%" },
      actions = { x = "-20%", y = "40%", width = "20%", height = "30%" },
      cast = { x = "30%", y = "10%", width = "40%", height = "20%" }
    }
  }
}

-- Profile management functions
function GUI.AdjustableContainers.switchProfile(profileName)
  if not GUI.AdjustableContainers.profiles[profileName] then
    print("ERROR: Profile '" .. profileName .. "' does not exist")
    return false
  end
  
  print("Switching to profile: " .. GUI.AdjustableContainers.profiles[profileName].name)
  GUI.AdjustableContainers.currentProfile = profileName
  
  -- Apply profile to all containers
  local profile = GUI.AdjustableContainers.profiles[profileName]
  for containerName, containerInfo in pairs(GUI.AdjustableContainers.containers) do
    local componentType = containerInfo.componentType
    local profileConfig = profile.containers[componentType]
    
    if profileConfig and containerInfo.container then
      containerInfo.container:move(profileConfig.x, profileConfig.y)
      containerInfo.container:resize(profileConfig.width, profileConfig.height)
    end
  end
  
  print("✓ Applied profile: " .. profileName)
  return true
end

function GUI.AdjustableContainers.saveProfile(profileName)
  if not profileName then
    profileName = GUI.AdjustableContainers.currentProfile
  end
  
  print("Saving profile: " .. profileName)
  Adjustable.Container:saveAll(profileName)
  print("✓ Profile saved: " .. profileName)
end

function GUI.AdjustableContainers.loadProfile(profileName)
  if not profileName then
    profileName = GUI.AdjustableContainers.currentProfile
  end
  
  print("Loading profile: " .. profileName)
  Adjustable.Container:loadAll(profileName)
  GUI.AdjustableContainers.currentProfile = profileName
  print("✓ Profile loaded: " .. profileName)
end

function GUI.AdjustableContainers.resetProfile(profileName)
  if not profileName then
    profileName = GUI.AdjustableContainers.currentProfile
  end
  
  print("Resetting profile: " .. profileName)
  GUI.AdjustableContainers.switchProfile(profileName)
  GUI.AdjustableContainers.saveProfile(profileName)
  print("✓ Profile reset: " .. profileName)
end

-- Container utility functions
function GUI.AdjustableContainers.showAll()
  for name, containerInfo in pairs(GUI.AdjustableContainers.containers) do
    if containerInfo.container then
      containerInfo.container:show()
    end
  end
  print("✓ All containers shown")
end

function GUI.AdjustableContainers.hideAll()
  for name, containerInfo in pairs(GUI.AdjustableContainers.containers) do
    if containerInfo.container then
      containerInfo.container:hide()
    end
  end
  print("✓ All containers hidden")
end

function GUI.AdjustableContainers.listContainers()
  print("=== LuminariGUI Container Registry ===")
  print("Current Profile: " .. GUI.AdjustableContainers.currentProfile)
  print("Save Directory: " .. GUI.AdjustableContainers.saveDir)
  print("")
  
  for name, containerInfo in pairs(GUI.AdjustableContainers.containers) do
    local status = containerInfo.container and "✓" or "✗"
    print(string.format("%s %s (%s)", status, name, containerInfo.componentType))
  end
  
  print("")
  print("Available Profiles:")
  for profileName, profile in pairs(GUI.AdjustableContainers.profiles) do
    local marker = (profileName == GUI.AdjustableContainers.currentProfile) and "* " or "  "
    print(string.format("%s%s - %s", marker, profile.name, profile.description))
  end
end

-- Initialize the directory structure
function GUI.AdjustableContainers.init()
  -- Create save directory if it doesn't exist
  lfs.mkdir(GUI.AdjustableContainers.saveDir)
  
  -- Save default profile on first run
  if not io.exists(GUI.AdjustableContainers.saveDir .. "default.json") then
    GUI.AdjustableContainers.saveProfile("default")
  end
  
  print("✓ AdjustableContainers initialized")
  print("  Save Directory: " .. GUI.AdjustableContainers.saveDir)
  print("  Current Profile: " .. GUI.AdjustableContainers.currentProfile)
end
</script>
