-- list of possible movement directions and appropriate coordinate changes
local move_vectors = {
    north = {0,1,0}, south = {0,-1,0}, east = {1,0,0}, west = {-1,0,0},
    northwest = {-1,1,0}, northeast = {1,1,0}, southwest = {-1,-1,0}, southeast = {1,-1,0},
    up = {0,0,1}, down = {0,0,-1}
}

-- used to convert short dirs for full dirs
local exits = {
    n = "north", s = "south", w = "west", e = "east",
    nw = "northwest", ne = "northeast", sw = "southwest", se = "southeast",
    u = "up", d = "down"
}

local exitmap = {
    north = 1,      northeast = 2,      northwest = 3,      east = 4,
    west = 5,       south = 6,          southeast = 7,      southwest = 8,
    up = 9,         down = 10,          ["in"] = 11,        out = 12,
    [1] = "north",  [2] = "northeast",  [3] = "northwest",  [4] = "east",
    [5] = "west",   [6] = "south",      [7] = "southeast",  [8] = "southwest",
    [9] = "up",     [10] = "down",      [11] = "in",        [12] = "out",
}

local function make_room()
    local info = map.room_info
    local coords = {0,0,0}
    GUI.debug("MAPPER/ROOM", "creating room", {
        room = info,
        previousRoom = map.prev_info,
    })
    addRoom(info.VNUM)
    local areas = getAreaTable()
    local areaID = areas[info.AREA]
    if not areaID then
        GUI.debug("MAPPER/ROOM", "creating map area", info.AREA)
        areaID = addAreaName(info.AREA)
    else
        coords = {getRoomCoordinates(map.prev_info.VNUM)}								
        local shift = {0,0,0}
        for k,v in pairs(map.prev_info.EXITS) do
            if v == info.VNUM and move_vectors[k] then
                shift = move_vectors[k]								
                break
            end
        end
				
        for n = 1,3 do
            coords[n] = coords[n] + shift[n]
        end
											
        -- map stretching
        local overlap = getRoomsByPosition(areaID,coords[1],coords[2],coords[3])				
        GUI.debug("MAPPER/ROOM", "calculated room coordinates", {
            areaID = areaID,
            coordinates = coords,
            shift = shift,
            overlap = overlap,
        })
				
        if not table.is_empty(overlap) then
            local rooms = getAreaRooms(areaID)
            local rcoords		
            for _,id in ipairs(rooms) do
                local x, y, z = getRoomCoordinates(id)
								rcoords = {x, y, z}
                for n = 1,3 do
                    if shift[n] ~= 0 and (rcoords[n] - coords[n]) * shift[n] &gt;= 0 then
                        rcoords[n] = rcoords[n] + shift[n]
                    end
                end
                setRoomCoordinates(id,rcoords[1],rcoords[2],rcoords[3])
            end
        end
    end
		setRoomArea(info.VNUM, areaID)
    setRoomCoordinates(info.VNUM, coords[1], coords[2], coords[3])
    if terrain_types[info.TERRAIN] then
        setRoomEnv(info.VNUM, terrain_types[info.TERRAIN].id + 16)
    end
    -- Set the room name from MSDP data
    if info.NAME then
        setRoomName(info.VNUM, info.NAME)
    end
		if map.prev_info then -- Check if you moved into here from another room.
			local prev_exits = getRoomExits(map.prev_info.VNUM)
			for dir, id in pairs(map.prev_info.EXITS) do
				if prev_exits[dir] == nil then
			    if not setExit(map.prev_info.VNUM, id, exitmap[dir]) then       
            setExitStub(map.prev_info.VNUM, exitmap[dir], true)
          end
				end
			end
		end
    for dir, id in pairs(info.EXITS) do
        -- need to see how special exits are represented to handle those properly here				
        if not setExit(info.VNUM, id, exitmap[dir]) then       
            setExitStub(info.VNUM, exitmap[dir], true)
        end
    end
    GUI.debug("MAPPER/ROOM", "room creation complete", {
        vnum = info.VNUM,
        areaID = areaID,
        coordinates = coords,
        exits = info.EXITS,
    })
end

local function shift_room(dir)
    local ID = map.room_info.VNUM
    local x,y,z = getRoomCoordinates(ID)
    local x1,y1,z1 = move_vectors[dir]
    GUI.debug("MAPPER/SHIFT", "shifting room", {
        direction = dir,
        vnum = ID,
        before = {x, y, z},
        vector = {x1, y1, z1},
    })
    x = x + x1
    y = y + y1
    z = z + z1
    setRoomCoordinates(ID,x,y,z)
    updateMap()
    GUI.debug("MAPPER/SHIFT", "room shifted", {
        vnum = ID,
        after = {x, y, z},
    })
end

local function handle_move()
  GUI.debug("MAPPER/MOVE", "handling room movement", {
    enabled = map.enabled,
    room = map.room_info,
  })
	if map.enabled == true and map.room_info.ENVIRONMENT ~= "Wilderness" then
    if not getRoomName(map.room_info.VNUM) then
        GUI.debug("MAPPER/MOVE", "room absent from map; creating it", map.room_info.VNUM)
        make_room()
    else		
			if terrain_types[map.room_info.TERRAIN] then
        setRoomEnv(map.room_info.VNUM, terrain_types[map.room_info.TERRAIN].id + 16)
    	end 	  
      local stubs = getExitStubs1(map.room_info.VNUM)				
			if stubs then		
       	for _, n in ipairs(stubs) do
          local dir = exitmap[n]				
	        local id = map.room_info.EXITS[dir]
	        -- need to see how special exits are represented to handle those properly here
	        if getRoomName(id) then	        
					  setExit(map.room_info.VNUM, id, exitmap[dir])
	        end
  	    end
			end
    end
	end
  GUI.debug("MAPPER/MOVE", "centering mapper", map.room_info.VNUM)
  centerview(map.room_info.VNUM)
end

local function make_aliases()
    -- Create mapping control aliases
    -- Uses named keys in map.aliases for proper cleanup on reload
    local id
    local tbl = {
        ["Start Mapping Alias"] = {[[^start mapping$]], [[map.start_mapping()]]},
        ["Stop Mapping Alias"] = {[[^stop mapping$]], [[map.stop_mapping()]]},
        ["Mapping On Alias"] = {[[^mc on$]], [[map.start_mapping()]]},
        ["Mapping Off Alias"] = {[[^mc off$]], [[map.stop_mapping()]]},
        ["Shift Room Alias"] = {[[^shift (\w+)$]], [[raiseEvent("shiftRoom",matches[2])]]},
    }
    for k, v in pairs(tbl) do
        GUI.debug("MAPPER/ALIAS", "preparing mapping alias", {
            name = k,
            pattern = v[1],
            existingId = map.aliases[k],
        })
        if map.aliases[k] and exists(map.aliases[k], "alias") ~= 0 then
            killAlias(map.aliases[k])
        end
        id = tempAlias(v[1], v[2])
        map.aliases[k] = id
        GUI.debug("MAPPER/ALIAS", "mapping alias registered", {
            name = k,
            handlerId = id,
        })
    end
end

function map.load_map(use_local)
    local path = getMudletHomeDir() .. "/map.dat"		
    GUI.debug("MAPPER/DOWNLOAD", "load_map requested", {
        useLocal = use_local,
        path = path,
    })
    if use_local then
        loadMap(path)
        print("Map reloaded from local copy.")
    else
        local address = 'http://www.luminarimud.com/download/map.dat'
        map.downloading = true
        downloadFile(path,address)
        print("Downloading Map File.")
    end
end

function map.adjustMinimapFontSize()
  local w = map.minimap.get_width()
  local h = map.minimap.get_height()
  local font_size = 8
  repeat
    font_size = font_size + 1
    local width, height = calcFontSize(font_size)
    width = width * map.minimap_width
    height = height * map.minimap_height
  until (w &lt; width) or (h &lt; height)
	map.minimap_font_size = font_size - 1
  setMiniConsoleFontSize("map.minimap", map.minimap_font_size)
end

function map.adjustAsciimapFontSize()
  local w = map.minimap.get_width()
  local h = map.minimap.get_height()
  local font_size = 8
  repeat
    font_size = font_size + 1
    local width, height = calcFontSize(font_size)
    width = width * 20
    height = height * 11
  until (w &lt; width) or (h &lt; height)
	map.minimap_font_size = font_size - 1
  setMiniConsoleFontSize("map.minimap", map.minimap_font_size)
end

function map.calcMinimapPadding()
	local width = calcFontSize(map.minimap_font_size)
	local characters = map.minimap.get_width() / width
	return (characters - map.minimap_width) / 4
end

function map.calcAsciimapPadding()
	local width = calcFontSize(map.minimap_font_size)
	local characters = map.minimap.get_width() / width
	return (characters - 19) / 4
end

-- Public so GUI reset recovery can recreate the mapper while the current
-- connection remains active (resetProfile() does not emit connection or
-- protocol-enabled events).
local function mapperRuntimeReady()
    return map.container ~= nil
      and GUI.asciiMapContainer ~= nil
      and map.minimap ~= nil
      and map.mapwindow ~= nil
end

function map.initialize()
    -- A normal connection emits sysConnectionEvent and then
    -- sysProtocolEnabled("MSDP"). Both paths legitimately request mapper
    -- setup, but the views must only be created once. Replacing the two
    -- adjustable containers during the second event briefly destroys their
    -- live children and can leave stale Geyser windows behind.
    if mapperRuntimeReady() then
      GUI.debug("MAPPER/INIT", "mapper already initialized; reusing existing views", {
        container = type(map.container),
        mapwindow = type(map.mapwindow),
        minimap = type(map.minimap),
        asciiMapContainer = type(GUI.asciiMapContainer),
      })
      return true
    end

    GUI.debug("MAPPER/INIT", "mapper initialization starting", {
      terrainCount = GUI.debugCountEntries(terrain_types),
      adjustableNamespace = type(GUI.AdjustableContainers),
      createFunction = type(GUI.AdjustableContainers and GUI.AdjustableContainers.create),
      GeyserMapper = type(Geyser and Geyser.Mapper),
      GeyserMiniConsole = type(Geyser and Geyser.MiniConsole),
    })
    -- setting terrain colors
    for k,v in pairs(terrain_types) do
        setCustomEnvColor(v.id + 16, v.r, v.g, v.b, 255)
    end
    -- making mapper window
    local info = defaults.mapper
    
    -- Create map as Adjustable Container
    map.container = GUI.AdjustableContainers.create("Map", "map", {
      x = info.x,
      y = info.y,
      width = info.width,
      height = info.height,
      name = "LuminariGUI_Map",
      titleText = "Map",
      adjLabelstyle = GUI.AdjustableContainers.defaultStyle.adjLabelstyle,
      buttonstyle = GUI.AdjustableContainers.defaultStyle.buttonstyle,
      tabstyle = GUI.AdjustableContainers.defaultStyle.tabstyle,
      titleTxtColor = "green",
      padding = 9,
      lockStyle = "border",
      autoSave = true,
      autoLoad = true,
      attached = "tr",  -- Top-right attachment
      defaultDir = GUI.AdjustableContainers.saveDir,
      noClose = true
    })
    GUI.debug("MAPPER/INIT", "map adjustable container result", {
      container = type(map.container),
    })
    
    -- Create separate Adjustable Container for ASCII map
    GUI.asciiMapContainer = GUI.AdjustableContainers.create("ASCIIMap", "ascii_map", {
      x = info.x,
      y = info.y,
      width = info.width,
      height = info.height,
      name = "LuminariGUI_ASCIIMap",
      titleText = "ASCII Map",
      adjLabelstyle = info.adjLabelstyle or "background-color: rgba(0,0,0,0%); border: 4px solid #444444;",
      raiseOnClick = false,
      savePosition = true,
      titleTxtColor = "green",
      padding = 9,
      lockStyle = "border",
      autoSave = true,
      autoLoad = true,
      attached = "tr",  -- Top-right attachment
      defaultDir = GUI.AdjustableContainers.saveDir,
      noClose = true
    })
    GUI.debug("MAPPER/INIT", "ASCII map adjustable container result", {
      container = type(GUI.asciiMapContainer),
    })
    
    -- Create ASCII minimap MiniConsole inside the new container
		map.minimap = Geyser.MiniConsole:new({
  		name="map.minimap",
  		x=9, y= 25,
  		width="-18", height="-34",
		}, GUI.asciiMapContainer)
    GUI.debug("MAPPER/INIT", "ASCII minimap MiniConsole created", {
      minimap = type(map.minimap),
    })
		
		map.minimap:setColor("black")
		
		-- Keep reference for backward compatibility
		map.minimapcontainer = GUI.asciiMapContainer
		
		-- Hide ASCII map by default (Mudlet map shows first)
		GUI.asciiMapContainer:hide()
    
    -- Create mapper window within the adjustable container
    if not map.container then
      print("ERROR: Map container not created - cannot initialize mapper")
      return false
    end
    
		map.mapwindow = Geyser.Mapper:new({
      name = "map.mapwindow", 
      x = 0, 
      y = 0, 
      width = "100%", 
      height = "100%"
    }, map.container)
    GUI.debug("MAPPER/INIT", "Geyser.Mapper creation returned", {
      mapwindow = type(map.mapwindow),
    })
    
    if not map.mapwindow then
      print("ERROR: Failed to create Geyser.Mapper instance")
      return false
    end
    
    -- Single initialization timer to ensure proper rendering
    GUI.setOwnedTimer("mapper.render", 0.2, GUI.debugWrap("MAPPER/INIT/render timer", function()
      if map.mapwindow then
        map.mapwindow:show()
        map.mapwindow:resize()
        -- Force a second resize to handle any rendering issues
        map.mapwindow:resize()
      else
        print("ERROR: Failed to initialize map window")
      end
    end))
    
    -- Show the map container
    if map.container then
      map.container:show()
      -- No need to manipulate z-order here - let Adjustable Container handle it
    end
		
		map.adjustMinimapFontSize()
		make_aliases()		
		
		map.get_default_map()
    GUI.debug("MAPPER/INIT", "mapper initialization complete", {
      container = type(map.container),
      mapwindow = type(map.mapwindow),
      minimap = type(map.minimap),
      asciiMapContainer = type(GUI.asciiMapContainer),
    })
    return true
end

function map.get_default_map()
	-- If the user has no map, download the default map from the server!
	local areas = getAreaTable()
	local path = getMudletHomeDir() .. "/map.dat"
  GUI.debug("MAPPER/DOWNLOAD", "checking for default map", {
    mosswoodArea = areas["Mosswood"],
    path = path,
  })
	 
	
	if (areas["Mosswood"] == nil) then
		local address = 'http://www.luminarimud.com/download/map.dat'
    map.downloading = true
    downloadFile(path, address)
    print("Downloading Map File.")
	end
end

function map.start_mapping()
  map.enabled=true
  GUI.debug("MAPPER", "mapping enabled")
	print("Mapping enabled.")
end

function map.stop_mapping()
	map.enabled=false
  GUI.debug("MAPPER", "mapping disabled")
	print("Mapping disabled.")
end

function map.eventHandler(event,...)     
    local arguments = {...}
    GUI.debug("MAPPER/EVENT", "event received", {
        event = event,
        arguments = arguments,
        downloading = map.downloading,
        room = msdp and msdp.ROOM,
    })
    if event == "msdp.ROOM" then
        map.prev_info = map.room_info
        map.room_info = table.update({},msdp.ROOM)
        GUI.debug("MAPPER/EVENT", "room state copied", {
            previousRoom = map.prev_info,
            currentRoom = map.room_info,
        })
				-- Check if we have moved between regular and wilderness areas

				if map.prev_info.ENVIRONMENT == "Wilderness" and map.room_info.ENVIRONMENT == "Room" then
           GUI.debug("MAPPER/EVENT", "transition Wilderness -&gt; Room")
					 -- re-enable the mapper!
					 if GUI.asciiMapContainer then GUI.asciiMapContainer:hide() end
					 if map.container then 
					   map.container:show()
					   -- Delay mapper refresh to ensure container is visible
					   GUI.setOwnedTimer("mapper.roomTransitionResize", 0.1, GUI.debugWrap("MAPPER/EVENT/room transition resize", function()
					     if map.mapwindow then
					       map.mapwindow:show()
					       map.mapwindow:resize()
					     end
					   end))
					 end
				elseif map.prev_info.ENVIRONMENT == "Room" and map.room_info.ENVIRONMENT == "Wilderness" then
           GUI.debug("MAPPER/EVENT", "transition Room -&gt; Wilderness")
					 -- disable the mapper!
					 if map.container then map.container:hide() end
					 if GUI.asciiMapContainer then GUI.asciiMapContainer:show() end
				end
        handle_move()
    elseif event == "shiftRoom" then
        local requestedDirection = arguments[1]
        local dir = exits[requestedDirection] or requestedDirection
        GUI.debug("MAPPER/EVENT", "shiftRoom requested", {
            requested = requestedDirection,
            normalized = dir,
        })
        if not table.contains(exits, dir) then
            echo("Error: Invalid direction '" .. dir .. "'.")
        else
            shift_room(dir)
        end
		elseif event == "sysDownloadDone" and map.downloading then
        GUI.debug("MAPPER/DOWNLOAD", "download finished; loading map")
        loadMap(getMudletHomeDir() .. "/map.dat")
        map.downloading = false
        print("Map File Loaded.")				
    elseif event == "sysConnectionEvent" then
        GUI.debug("MAPPER/EVENT", "connection event initializing mapper")
        map.initialize()
		end
		
end

function map.onProtocolEnabled(_, protocol)
  GUI.debug("MAPPER/PROTOCOL", "sysProtocolEnabled received", {
    protocol = protocol,
  })
  if protocol == "MSDP" then
    print("MSDP enabled!")
    GUI.debug("MAPPER/PROTOCOL", "requesting ROOM and initializing mapper")
		sendMSDP("REPORT", "ROOM")
		map.initialize()
  end
end

map.fileScopeHandlerIds = map.fileScopeHandlerIds or {}
map.fileScopeHandlerEvents = {
  ["msdp.ROOM"] = true,
  ["shiftRoom"] = true,
  ["sysConnectionEvent"] = true,
  ["sysProtocolEnabled"] = true,
  ["sysDownloadDone"] = true,
}
local function registerFileScopeHandler(event, handler)
  local handlerId = GUI.registerOwnedHandler(
    map.fileScopeHandlerIds,
    event,
    event,
    handler,
    "MAPPER/" .. event
  )
  GUI.debug("MAPPER/EVENT", "file-scope handler registration", {
    event = event,
    handler = handler,
    handlerId = handlerId,
  })
  return handlerId
end

function map.unregisterFileScopeHandlers()
  return GUI.unregisterOwnedHandlers(
    map.fileScopeHandlerIds,
    map.fileScopeHandlerEvents
  )
end

registerFileScopeHandler("msdp.ROOM", "map.eventHandler")
registerFileScopeHandler("shiftRoom", "map.eventHandler")
registerFileScopeHandler("sysConnectionEvent", "map.eventHandler")
registerFileScopeHandler("sysProtocolEnabled", "map.onProtocolEnabled")
registerFileScopeHandler("sysDownloadDone", "map.eventHandler")
GUI.debug("MAPPER/EVENT", "file-scope handlers registered", map.fileScopeHandlerIds)</script>
