						<Script isActive="yes" isFolder="no">
							<name>demonnicOnInstall</name>
							<packageName></packageName>
							<script>function demonnicOnInstall(_, package)
  GUI.debug("YATCO/INSTALL", "sysInstall received", {
    package = package,
  })
  -- Check for both LuminariGUI and YATCO package names to handle mid-session imports
  if type(package) == "string" and
    (package:find("YATCO") or package:find("LuminariGUI")) then
    demonnicOnStart()
  end
end</script>
