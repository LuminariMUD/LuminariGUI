# Example Environment file for the application, copy as `.env` and fill in the values

# if you want a player account with "Forger" (highest staff character)
#   access ... this works for both production and local-dev
GAME_MASTER_ACCOUNT=<account name>
GAME_MASTER_ACCOUNT_PASSWORD=<account password>

# Origin server: upload the versioned package and copy it as LuminariGUI.mpackage.
UPLOAD_SSH_COMMAND="ssh <target>"
UPLOAD_SSH_PATH="/path/to/download/folder"

# Public downloads are served by Cloudflare Pages; SSH upload alone is insufficient.
CLOUDFLARE_ACCOUNT_ID="<Cloudflare account ID>"
CLOUDFLARE_API_TOKEN="<token with Pages deployment access>"
CLOUDFLARE_PAGES_PROJECT="<Pages project name>"
CLOUDFLARE_PAGES_BRANCH="<production branch>"
WEBSITE_REPO_URL="<website Git clone URL>"
WEBSITE_SOURCE_DIR="<Astro project path within website repo>"
WEBSITE_ORIGIN_DOWNLOAD_DIR="<origin download directory within website repo>"
WEBSITE_PUBLIC_DOWNLOAD_DIR="<public download directory within Astro project>"
RELEASE_PUBLIC_BASE_URL="https://<public hostname>/download"

# If the website checkout is absent, clone WEBSITE_REPO_URL into a temporary directory.
# Update versioned + LuminariGUI.mpackage in WEBSITE_ORIGIN_DOWNLOAD_DIR (repo-relative)
# and WEBSITE_PUBLIC_DOWNLOAD_DIR (relative to WEBSITE_SOURCE_DIR). Keep other assets.
# In WEBSITE_SOURCE_DIR: CI=true pnpm install --frozen-lockfile; CI=true pnpm quality
# Commit/push the download changes, then deploy the complete dist/ to the Pages project/branch.
# Verify both public download SHA-256 values after redirects; never deploy only the packages.
